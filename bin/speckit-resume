#!/usr/bin/env bash
# speckit-resume — print the task an interrupted implement run should resume at.
#
# WHY THIS EXISTS
#
# The implement rule says "resume at the first task without a `complete` ledger line".
# That is an algorithm, but it was prose the agent had to interpret, and the only way to
# test it was to watch a live run. Made mechanical, it has an oracle (this script) and a
# property that can be asserted in the gate — the same move the kit makes everywhere else:
# a rule that can be computed should be computed, not interpreted.
#
# The ledger is authoritative, not the checkbox. A ticked task with no `Task <n>: complete`
# line is NOT done — completion claims are not evidence. Reading the ledger rather than the
# conversation is what makes a run resumable after compaction.
#
# Usage:  speckit-resume <spec-dir>
#         speckit-resume --criteria <spec-dir>      print only the n/m criteria tally
# Output: "RESUME T003"  |  "COMPLETE"  |  "<spec>  n/m evidenced; gaps: ..."
# Exit:   0 normally, 2 if tasks.md is missing (or a cited criterion id is unknown),
#         3 if the spec declares no acceptance criteria (005 FR-008)
set -euo pipefail

CRITERIA=0
if [ "${1:-}" = "--criteria" ]; then CRITERIA=1; shift; fi
SPEC="${1:-}"
if [ -z "$SPEC" ]; then
  echo "usage: speckit-resume [--criteria] <spec-dir>" >&2
  exit 2
fi

if [ "$CRITERIA" = "1" ]; then
  python3 - "$SPEC" <<'PY'
import os, re, sys
spec_dir = sys.argv[1]
spec = os.path.join(spec_dir, "spec.md")
if not os.path.exists(spec):
    sys.stderr.write("no spec.md in %s\n" % spec_dir)
    sys.exit(2)
with open(spec) as fh:
    text = fh.read()
ids = ["SC-%s" % n for n in sorted(set(re.findall(r"\*\*SC-(\d{3})\*\*", text)))]
if not ids:
    sys.stderr.write("%s declares no acceptance criteria (SC-xxx); completion cannot be "
                     "reported\n" % spec)
    sys.exit(3)
progress = os.path.join(spec_dir, "progress.md")
cited = set()
if os.path.exists(progress):
    with open(progress) as fh:
        # A citation is an explicit [SC-003]: a prose mention of an id is not evidence.
        cited = set(re.findall(r"\[(SC-\d{3})\]", fh.read()))
unknown = sorted(cited - set(ids))
if unknown:
    sys.stderr.write("%s cites criterion id(s) the spec does not declare: %s\n"
                     % (progress, ", ".join(unknown)))
    sys.exit(2)
evidenced = [i for i in ids if i in cited]
gaps = [i for i in ids if i not in cited]
print("%s  %d/%d evidenced; gaps: %s"
      % (spec, len(evidenced), len(ids), ", ".join(gaps) if gaps else "none"))
PY
  exit 0
fi
TASKS="$SPEC/tasks.md"
LEDGER="$SPEC/progress.md"
if [ ! -f "$TASKS" ]; then
  echo "no tasks.md in $SPEC" >&2
  exit 2
fi

python3 - "$TASKS" "$LEDGER" "$SPEC" <<'PY'
import os, re, sys

tasks_path, ledger_path, spec_dir = sys.argv[1], sys.argv[2], sys.argv[3]

# Task order comes from tasks.md; ids are matched numerically so `T003` and `Task 3`
# are the same task.
tasks = []
for line in open(tasks_path, encoding="utf-8"):
    m = re.match(r"\s*- \[[ xX]\] (T(\d+))\b", line)
    if m:
        tasks.append((int(m.group(2)), m.group(1)))

# Identity first: a ledger that names a DIFFERENT plan is not evidence about this one.
# Backward compatible — a ledger with no header still resumes (older projects), but a
# header that names another plan is refused rather than silently trusted.
if os.path.exists(ledger_path):
    with open(ledger_path, encoding="utf-8") as f:
        for _ in range(5):
            head = f.readline()
            if not head:
                break
            m = re.match(r"#\s*Progress\s*[\u2014\u2013-]\s*plan:\s*(\S+)", head)
            if m:
                declared = m.group(1).strip()
                expected = os.path.normpath(os.path.join(spec_dir, "plan.md"))
                if os.path.isabs(declared):
                    same = os.path.realpath(declared) == os.path.realpath(expected)
                else:
                    same = os.path.normpath(declared) == expected
                if not same:
                    print(
                        "ledger names %s, not %s — refusing to resume (wrong plan's evidence)"
                        % (declared, expected),
                        file=sys.stderr,
                    )
                    sys.exit(2)
                break

# Completion comes from the ledger, and only from a `complete` line. A `fix round n/m`
# line is explicitly not completion.
done = set()
unbacked = []
if os.path.exists(ledger_path):
    for line in open(ledger_path, encoding="utf-8"):
        m = re.match(r"\s*Task (\d+): complete\b", line)
        if m:
            done.add(int(m.group(1)))
            # "complete" alone is a claim. Evidence is the parenthesised reason. Warn, do
            # not fail: older ledgers predate the convention, and stranding a resume would
            # be a worse defect than the claim it is flagging.
            if not re.search(r"complete\s*\(\s*\S", line):
                unbacked.append(int(m.group(1)))
if unbacked:
    print(
        "note: Task %s recorded complete with no evidence in parentheses — completion claims are not evidence"
        % ", ".join(str(n) for n in unbacked),
        file=sys.stderr,
    )

for num, tid in tasks:
    if num not in done:
        print(f"RESUME {tid}")
        sys.exit(0)
print("COMPLETE")
PY
