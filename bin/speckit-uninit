#!/usr/bin/env bash
# speckit-uninit — reverse what `speckit-init` did to a project.
#
# Usage:
#   speckit-uninit [--dry-run] [--keep-specs] [path]
#
# Removes the Spec Kit scaffolding this kit installs:
#   .specify/            workflow registry, scripts, templates, installed preset
#   .opencode/commands/  the speckit.* command files (only those)
#   AGENTS.md            the SPECKIT-BRIDGE block, and the extension's managed block
#
# It does NOT touch:
#   specs/               your feature artifacts (unless --keep-specs is absent AND
#                        you confirm — see below)
#   any other file in .opencode/ (your own commands, config, hooks)
#   your own AGENTS.md content outside the two managed blocks
#
# Default is conservative: `specs/` is KEPT, because it is your work, not scaffolding.
# Pass --remove-specs to delete it too.
set -euo pipefail

BRIDGE_START="<!-- SPECKIT-BRIDGE START -->"
BRIDGE_END="<!-- SPECKIT-BRIDGE END -->"
CMDS_START="<!-- SPECKIT-COMMANDS START -->"
CMDS_END="<!-- SPECKIT-COMMANDS END -->"
EXT_START="<!-- SPECKIT START -->"
EXT_END="<!-- SPECKIT END -->"

DRY=false
REMOVE_SPECS=false
TARGET=""
for arg in "$@"; do
  case "$arg" in
    --dry-run)      DRY=true ;;
    --remove-specs) REMOVE_SPECS=true ;;
    --help|-h)      sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)             echo "error: unknown option '$arg'" >&2; exit 1 ;;
    *)              TARGET="$arg" ;;
  esac
done
TARGET="${TARGET:-.}"
[[ -d "$TARGET" ]] || { echo "error: '$TARGET' is not a directory" >&2; exit 1; }
ROOT="$(cd "$TARGET" && pwd)"

# Resolve the kit root from this script's own location, so uninit can tell "the
# hooks file we shipped" from "a hooks file the project edited".
SELF="$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$0" 2>/dev/null || echo "$0")"
KIT_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

say()  { printf '\033[1;36m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
run()  { if $DRY; then printf '   would: %s\n' "$*"; else eval "$@"; fi; }

[[ -d "$ROOT/.specify" ]] || warn "no .specify/ in $ROOT — nothing looks installed"

# --- 1. AGENTS.md: strip only the two managed blocks ---------------------------
AGENTS="$ROOT/AGENTS.md"
if [[ -f "$AGENTS" ]]; then
  if $DRY; then
    say "would strip the SPECKIT-BRIDGE, SPECKIT-COMMANDS and SPECKIT blocks from AGENTS.md"
  else
    python3 - "$AGENTS" "$BRIDGE_START" "$BRIDGE_END" "$CMDS_START" "$CMDS_END" "$EXT_START" "$EXT_END" <<'PY'
import re, sys
path, bs, be, cs, ce, es, ee = sys.argv[1:8]
s = open(path, encoding="utf-8").read()
before = s
for start, end in ((bs, be), (cs, ce), (es, ee)):
    s = re.sub(re.escape(start) + r".*?" + re.escape(end) + r"\n?", "", s, flags=re.S)
s = re.sub(r"\n{3,}", "\n\n", s).strip()
if s:
    open(path, "w", encoding="utf-8").write(s + "\n")
    print("   stripped managed blocks from AGENTS.md")
else:
    # Nothing of the user's own remained, so the file was ours entirely.
    import os
    os.remove(path)
    print("   AGENTS.md contained only managed blocks — removed")
PY
  fi
fi

# --- 2. .opencode/commands: remove only the speckit.* files --------------------
CMDS="$ROOT/.opencode/commands"
if [[ -d "$CMDS" ]]; then
  # Only the kit-owned names: `speckit.md` and `speckit.*.md`. A `speckit*.md` glob
  # would also delete a user file like `speckit-notes.md`.
  n=0
  for f in "$CMDS"/speckit.md "$CMDS"/speckit.*.md; do [[ -f "$f" ]] && n=$((n+1)); done
  if [[ "$n" != "0" ]]; then
    say "removing $n speckit.* command file(s) from .opencode/commands/"
    run "rm -f \"$CMDS\"/speckit.md \"$CMDS\"/speckit.*.md"
  fi
  # If the directory is now empty, it was ours; remove it.
  if ! $DRY && [[ -d "$CMDS" ]] && [[ -z "$(ls -A "$CMDS" 2>/dev/null)" ]]; then
    rmdir "$CMDS" 2>/dev/null || true
    rmdir "$ROOT/.opencode" 2>/dev/null || true
  fi
fi

# --- 3. .specify/ --------------------------------------------------------------
if [[ -d "$ROOT/.specify" ]]; then
  if [[ -f "$ROOT/.specify/ledger.jsonl" ]]; then
    say "removing .specify/ — including .specify/ledger.jsonl, which is evidence: copy it first if you need the trail"
  else
    say "removing .specify/"
  fi
  run "rm -rf \"$ROOT/.specify\""
fi

# --- 3b. hooks we installed ----------------------------------------------------
# Remove only OUR hooks file — and only if it is still byte-identical to the one we
# ship. If the project edited it, it is theirs now and we leave it alone.
HOOK_DST="$ROOT/.opencode/hook/hooks.yaml"
HOOK_REF="$KIT_ROOT/hooks/speckit-hooks.yaml"
if [[ -f "$HOOK_DST" ]]; then
  if [[ -f "$HOOK_REF" ]] && cmp -s "$HOOK_REF" "$HOOK_DST"; then
    say "removing project hooks (unmodified copy of ours)"
    run "rm -f \"$HOOK_DST\""
    $DRY || rmdir "$ROOT/.opencode/hook" 2>/dev/null || true
  else
    say "kept .opencode/hook/hooks.yaml — it has local edits, so it is yours"
  fi
fi

# --- 3c. permission boundary, autonomy contract, scripts/verify ----------------
# Each is removed only if it is still exactly what we installed. If the project
# edited it, it is theirs and we leave it alone.
PERM_REF="$KIT_ROOT/permissions/opencode-permission.jsonc"
# `specify preset add/update` normalises an existing opencode.json (it strips blank
# lines), so a byte comparison would never match. Compare ignoring blank lines; any
# other difference means the project added something and the file is theirs.
perm_ours() {
  diff -q <(grep -v '^[[:space:]]*$' "$PERM_REF" 2>/dev/null) \
          <(grep -v '^[[:space:]]*$' "$1" 2>/dev/null) >/dev/null 2>&1
}
for j in "$ROOT/opencode.json" "$ROOT/opencode.jsonc"; do
  if [[ -f "$j" && -f "$PERM_REF" ]] && perm_ours "$j"; then
    say "removing $(basename "$j") (unmodified copy of our permission boundary)"
    run "rm -f \"$j\""
  elif [[ -f "$j" ]]; then
    say "kept $(basename "$j") — it has local edits, so it is yours"
  fi
done

CONTRACT_DST="$ROOT/.opencode/autonomy-contract.md"
CONTRACT_REF="$KIT_ROOT/global/autonomy-contract.md"
if [[ -f "$CONTRACT_DST" ]]; then
  if [[ -f "$CONTRACT_REF" ]] && cmp -s "$CONTRACT_REF" "$CONTRACT_DST"; then
    say "removing autonomy contract (unmodified copy of ours)"
    run "rm -f \"$CONTRACT_DST\""
  else
    say "kept .opencode/autonomy-contract.md — it has local edits, so it is yours"
  fi
fi

# `scripts/verify` is generated per project, so there is no reference copy to compare
# against. Require the exact generated shape instead: shebang, the generated comment,
# `set -euo pipefail`, the run() definition, and `run "<name>" <cmd>` lines. Anything
# else means the project customised it, and it is kept.
verify_is_ours() {
  awk '
    /^#/                          {next}
    /^set -euo pipefail$/          {next}
    /^run\(\) \{/                  {next}
    /^run "[a-z]+" /               {next}
    /^if \[ -f "\.specify\/verify\.json" \] && \[ -x "bin\/speckit-verify" \]; then/ {next}
    /^[[:space:]]*exec bin\/speckit-verify "\$@"$/ {next}
    /^fi$/                        {next}
    /^[[:space:]]*$/               {next}
    {exit 1}
  ' "$1"
}
VERIFY="$ROOT/scripts/verify"
if [[ -f "$VERIFY" ]] && verify_is_ours "$VERIFY"; then
  say "removing scripts/verify (unmodified generated file)"
  run "rm -f \"$VERIFY\""
  $DRY || rmdir "$ROOT/scripts" 2>/dev/null || true
elif [[ -f "$VERIFY" ]]; then
  say "kept scripts/verify — it has local edits, so it is yours"
fi

# --- 3b. Verification engine (005) --------------------------------------------
# The three helpers carry a `# —` doc line and nothing else in their first two lines, so a file
# with that shape is the one this installer wrote. Anything else is kept.
for _engine in speckit-verify speckit-ledger speckit-security; do
  if [[ -f "$ROOT/bin/$_engine" ]] && head -2 "$ROOT/bin/$_engine" | grep -q '^# —'; then
    say "removing bin/$_engine (installed helper)"
    run "rm -f \"$ROOT/bin/$_engine\""
  fi
done
$DRY || rmdir "$ROOT/bin" 2>/dev/null || true
# .specify/ — including the seeded manifest, the security directory and the ledger — was
# removed above with the generated tree. Earlier revisions of this block tried to keep the
# ledger and could not: it lives inside the directory that is removed.

# --- 4. specs/ (kept by default) ----------------------------------------------
if [[ -d "$ROOT/specs" ]]; then
  if $REMOVE_SPECS; then
    say "removing specs/ (--remove-specs)"
    run "rm -rf \"$ROOT/specs\""
  else
    say "kept specs/ — that is your work, not scaffolding (use --remove-specs to delete)"
  fi
fi

# --- 5. backups ----------------------------------------------------------------
for b in "$ROOT/AGENTS.md.pre-speckit.bak" "$ROOT/.specify/memory/constitution.md.pre-seed.bak"; do
  [[ -f "$b" ]] && { say "removing backup $(basename "$b")"; run "rm -f \"$b\""; }
done

if $DRY; then
  say "dry run — nothing was changed"
else
  say "done — $ROOT is back to its pre-Spec-Kit state"
  cat <<EOF

Review the result:
  git -C "$ROOT" status
  git -C "$ROOT" diff

If anything was missed, restore with:
  git -C "$ROOT" checkout .
EOF
fi
