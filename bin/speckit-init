#!/usr/bin/env bash
# speckit-init — set up GitHub Spec Kit (Spec-Driven Development) in a repo,
# wired for opencode + Freebuff/Codebuff.
#
# Usage:
#   speckit-init [options] [path]      # path defaults to the current directory
#   speckit-init --help
#
# Options:
#   --with-bug            also install the bundled `bug` extension
#   --with-assess         also install the bundled `assess` extension
#
# What it does:
#   1. Ensures the `specify` CLI is installed
#   2. `specify init --here` with the opencode integration
#   3. Installs this repo's preset (append strategy) so the constitution, spec,
#      plan and tasks templates gain the delivery principles, traceability and
#      verification sections
#   4. Installs the agent-context extension, pointed at AGENTS.md
#   5. Injects a short routing block into AGENTS.md
#
# Safe to re-run: the preset is replaced in place and the AGENTS.md block is
# rewritten between its own markers, never duplicated.
set -euo pipefail

BRIDGE_START="<!-- SPECKIT-BRIDGE START -->"
BRIDGE_END="<!-- SPECKIT-BRIDGE END -->"
PRESET_ID="spec-driven-development"
SPECKIT_PKG="specify-cli"

usage() { sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; }

WITH_BUG=false
WITH_ASSESS=false
TARGET=""
for arg in "$@"; do
  case "$arg" in
    --with-bug)          WITH_BUG=true ;;
    --with-assess)       WITH_ASSESS=true ;;
    --help|-h)           usage; exit 0 ;;
    -*)                  echo "error: unknown option '$arg'" >&2; exit 1 ;;
    *)                   TARGET="$arg" ;;
  esac
done
TARGET="${TARGET:-.}"

[[ -d "$TARGET" ]] || { echo "error: '$TARGET' is not a directory" >&2; exit 1; }
ROOT="$(cd "$TARGET" && pwd)"

# Resolve this script through any symlink so we can find the kit repo it lives in.
SELF="$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$0" 2>/dev/null || echo "$0")"
KIT_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
PRESET_DIR="$KIT_ROOT/preset"

say()  { printf '\033[1;36m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

# --- 1. CLI -------------------------------------------------------------------
if ! command -v specify >/dev/null 2>&1; then
  say "specify CLI not found — installing"
  command -v uv >/dev/null 2>&1 || die "need uv (https://docs.astral.sh/uv/) to install ${SPECKIT_PKG}"
  uv tool install "$SPECKIT_PKG"
else
  say "specify CLI v$(specify version 2>/dev/null | grep -oE 'CLI Version +[0-9][0-9.]*' | grep -oE '[0-9][0-9.]*' | head -1 || true)"
fi

# --- 2. Project scaffolding ---------------------------------------------------
if [[ -d "$ROOT/.specify" ]]; then
  say ".specify/ already present — re-running init to refresh"
else
  if [[ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null || true)" ]]; then
    warn "uncommitted changes in $ROOT — commit or stash first so the diff is reviewable"
  fi
  ( cd "$ROOT" && specify init --here --force --non-interactive --ignore-agent-tools \
      --integration opencode --script sh ) >/dev/null
  say "scaffolded .specify/ + .opencode/commands/"
fi

cd "$ROOT"

# --- 2b. Deterministic entry-point command -------------------------------------
# A preset can only `prepend` to commands that already exist — it cannot create one
# (verified: a preset entry naming a new command is silently ignored). So /speckit is
# copied here instead.
#
# Why it exists: the `spec-driven-development` skill loads on roughly 60% of relevant
# requests. Skill matching is semantic, so the skill is a probability surface — fine
# for reasoning, wrong for anything that must always apply. An invoked command is
# deterministic to *invoke*: the user typed it, so it ran. (It is not deterministic to
# *obey* — commands are prompt text like any other, and the model can still deviate.
# A rule that must not be violable needs a hook or a permission, not a command.)
# This gives the workflow a reliable entry point without making the skill carry rules.
ENTRY="$ROOT/.opencode/commands/speckit.md"
ENTRY_SRC="$KIT_ROOT/commands/speckit.md"
if [[ -f "$ENTRY_SRC" ]]; then
  if [[ -f "$ENTRY" ]] && cmp -s "$ENTRY_SRC" "$ENTRY"; then
    say "/speckit entry point already current"
  else
    cp "$ENTRY_SRC" "$ENTRY"
    say "installed /speckit entry point (deterministic workflow entry)"
  fi
else
  die "entry-point source missing at $ENTRY_SRC"
fi

# --- 3. Preset (template addenda + command contributions) ---------------------
# Uses `preset update` when the preset is already installed — that is the idiomatic
# replace flow (remove + add), and it is what keeps an existing project current.
if [[ -d "$PRESET_DIR" ]]; then
  SRC_VERSION="$(grep -E '^\s+version:' "$PRESET_DIR/preset.yml" 2>/dev/null | head -1 | sed 's/.*"\(.*\)".*/\1/')"
  PLIST="$(specify preset list 2>/dev/null || true)"
  if grep -q "$PRESET_ID" <<<"$PLIST"; then
    INST_VERSION="$(specify preset info "$PRESET_ID" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -E '^\s+Version:' | head -1 | awk '{print $2}')"
    if specify preset update "$PRESET_ID" --dev "$PRESET_DIR" >/dev/null 2>&1; then
      if [[ -n "$INST_VERSION" && "$INST_VERSION" != "$SRC_VERSION" ]]; then
        say "updated preset: $PRESET_ID $INST_VERSION -> $SRC_VERSION"
      else
        say "preset up to date: $PRESET_ID v$SRC_VERSION"
      fi
    else
      die "could not update preset — retry: specify preset update $PRESET_ID --dev \"$PRESET_DIR\""
    fi
  elif specify preset add --dev "$PRESET_DIR" >/dev/null 2>&1; then
    say "installed preset: $PRESET_ID v$SRC_VERSION (template addenda + command rules)"
  else
    die "could not install preset — retry: specify preset add --dev \"$PRESET_DIR\""
  fi
else
  die "preset directory not found at $PRESET_DIR — cannot install the template addenda or command rules"
fi

# --- 4. agent-context extension, pointed at AGENTS.md -------------------------
# NOTE: capture to a var first. Piping a verbose `specify` command straight into
# `grep -q` makes grep exit early on a match, killing the producer with EPIPE —
# and under `set -o pipefail` that non-zero status would be read as "not found".
EXT_LIST="$(specify extension list 2>/dev/null || true)"
if grep -q 'agent-context' <<<"$EXT_LIST"; then
  say "agent-context extension already installed"
elif specify extension add agent-context >/dev/null 2>&1; then
  say "installed agent-context extension"
else
  # Fail loudly. A half-installed project that looks fine is worse than a failed
  # install: the AGENTS.md anchor is what keeps the context file maintained, and
  # silently skipping it produces a project that appears set up but is not.
  die "could not install the agent-context extension — retry: specify extension add agent-context"
fi

CFG=".specify/extensions/agent-context/agent-context-config.yml"
if [[ -f "$CFG" ]]; then
  # Point the extension at AGENTS.md — the anchor BOTH opencode and Freebuff read.
  # Idempotency is handled inside the python block.
  if python3 - "$CFG" <<'PY'
import re, sys
p = sys.argv[1]
s = open(p).read()
if re.search(r'(?m)^[ \t]*-[ \t]*AGENTS\.md[ \t]*$', s):
    sys.exit(0)                      # already anchored
new = re.sub(r'(?m)^context_files:[ \t]*(\[\s*\])?[ \t]*$',
             'context_files:\n  - AGENTS.md', s)
if new == s:
    print("could not locate a context_files key to patch", file=sys.stderr)
    sys.exit(1)
open(p, 'w').write(new)
PY
  then
    say "agent context anchored to AGENTS.md"
  else
    die "could not anchor agent context to AGENTS.md — set context_files in $CFG by hand"
  fi
else
  die "agent-context config not found at $CFG — the extension did not install correctly"
fi

# --- 5. Optional bundled extensions -------------------------------------------
for pair in "bug:$WITH_BUG" "assess:$WITH_ASSESS"; do
  name="${pair%%:*}"; want="${pair##*:}"
  $want || continue
  ELIST="$(specify extension list 2>/dev/null || true)"
  if grep -q "$name" <<<"$ELIST"; then
    say "$name extension already installed"
  elif specify extension add "$name" >/dev/null 2>&1; then
    say "installed $name extension"
  else
    # Explicitly requested, so a failure is an error, not a warning.
    die "could not install the $name extension — retry: specify extension add $name"
  fi
done

# --- 6. AGENTS.md routing block ------------------------------------------------
# Deliberately short. The methodology lives in the `spec-driven-development`
# skill; this block only routes to it and gives command paths for agents that
# cannot invoke /speckit.* commands.
read -r -d '' BRIDGE <<'BRIDGE_EOF' || true
# Spec-Driven Development (Spec Kit)

This project uses Spec Kit. Requirements are written down before code is written, and the
artifacts under `specs/` are the source of truth.

**Load the `spec-driven-development` skill before specifying, planning, or implementing.**
It carries the workflow, approval gates, traceability and verification rules.

**Prefer `/speckit`.** It is the reliable entry point: it classifies the request, picks the
smallest workflow that fits, and routes to the right step. The skill above loads on roughly 60% of
relevant requests — invoke `/speckit` when you need the workflow to apply for certain.

## If you cannot invoke `/speckit.*` commands

Agents that do not read `.opencode/commands/` (e.g. Freebuff/Codebuff) can run each step by
reading the command prompt directly and following it as instructions:

| Step | File |
| --- | --- |
| entry point | `.opencode/commands/speckit.md` |
| constitution | `.opencode/commands/speckit.constitution.md` |
| specify | `.opencode/commands/speckit.specify.md` |
| plan | `.opencode/commands/speckit.plan.md` |
| tasks | `.opencode/commands/speckit.tasks.md` |
| implement | `.opencode/commands/speckit.implement.md` |
| converge | `.opencode/commands/speckit.converge.md` |
| clarify | `.opencode/commands/speckit.clarify.md` |
| analyze | `.opencode/commands/speckit.analyze.md` |
| checklist | `.opencode/commands/speckit.checklist.md` |

Substitute the user's feature description wherever the prompt expects `$ARGUMENTS`.
BRIDGE_EOF

AGENTS="$ROOT/AGENTS.md"
if [[ -f "$AGENTS" ]] && ! grep -qF "$BRIDGE_START" "$AGENTS" && [[ -s "$AGENTS" ]]; then
  cp "$AGENTS" "$AGENTS.pre-speckit.bak"
  say "backed up existing AGENTS.md -> AGENTS.md.pre-speckit.bak (diff it, then delete or gitignore)"
fi

python3 - "$AGENTS" "$BRIDGE_START" "$BRIDGE_END" <<PY
import sys
path, start, end = sys.argv[1], sys.argv[2], sys.argv[3]
body = """${BRIDGE}"""
old = open(path).read() if __import__('os').path.exists(path) else ""
new_block = start + "\n" + body + "\n" + end + "\n"
if start in old and end in old:
    pre = old.split(start)[0]
    post = old.split(end, 1)[1]
    out = pre + new_block + post.lstrip("\n")
    if old.endswith("\n") and not out.endswith("\n"):
        out += "\n"
else:
    out = (old.rstrip("\n") + "\n\n" if old.strip() else "") + new_block
open(path, "w").write(out)
PY
say "AGENTS.md routing block installed"

# --- 8. Let the extension seed its managed block ------------------------------
bash .specify/extensions/agent-context/scripts/bash/update-agent-context.sh >/dev/null 2>&1 || true

# --- Done ---------------------------------------------------------------------
cmds=$(ls -1 .opencode/commands/*.md 2>/dev/null | wc -l | tr -d ' ')
presets=$(ls -1 .specify/presets 2>/dev/null | wc -l | tr -d ' ')
say "done — $cmds commands, $presets preset(s) in $ROOT"
cat <<EOF

Next steps:
  1. Review the changes:  git status && git diff
  2. Open this folder in opencode or Freebuff
  3. Check the composition:  specify preset resolve spec-template
  4. Start the loop (opencode):
       /speckit.constitution
       /speckit.specify
       /speckit.plan
       /speckit.tasks
       /speckit.implement
       /speckit.converge

  In Freebuff, ask it to follow the spec-driven-development skill.
  Optional extensions: --with-bug  --with-assess
EOF
