#!/usr/bin/env bash
# speckit-init — set up GitHub Spec Kit (Spec-Driven Development) in a repo,
# wired for opencode + Freebuff/Codebuff.
#
# Usage:
#   speckit-init [options] [path]      # path defaults to the current directory
#   speckit-init --help
#
# Options:
#   --with-bug            also install the bundled `bug` extension
#   --with-assess         also install the bundled `assess` extension
#
# What it does:
#   1. Ensures the `specify` CLI is installed
#   2. `specify init --here` with the opencode integration
#   3. Installs this repo's preset (append strategy) so the constitution, spec,
#      plan and tasks templates gain the delivery principles, traceability and
#      verification sections
#   4. Installs the agent-context extension, pointed at AGENTS.md
#   5. Injects a short routing block into AGENTS.md
#
# Safe to re-run: the preset is replaced in place and the AGENTS.md block is
# rewritten between its own markers, never duplicated.
set -euo pipefail

BRIDGE_START="<!-- SPECKIT-BRIDGE START -->"
BRIDGE_END="<!-- SPECKIT-BRIDGE END -->"
CMDS_START="<!-- SPECKIT-COMMANDS START -->"
CMDS_END="<!-- SPECKIT-COMMANDS END -->"
PRESET_ID="spec-driven-development"
SPECKIT_PKG="specify-cli"

usage() { sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; }

WITH_BUG=false
WITH_ASSESS=false
TARGET=""
for arg in "$@"; do
  case "$arg" in
    --with-bug)          WITH_BUG=true ;;
    --with-assess)       WITH_ASSESS=true ;;
    --help|-h)           usage; exit 0 ;;
    -*)                  echo "error: unknown option '$arg'" >&2; exit 1 ;;
    *)                   TARGET="$arg" ;;
  esac
done
TARGET="${TARGET:-.}"

[[ -d "$TARGET" ]] || { echo "error: '$TARGET' is not a directory" >&2; exit 1; }
ROOT="$(cd "$TARGET" && pwd)"

# Resolve this script through any symlink so we can find the kit repo it lives in.
SELF="$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$0" 2>/dev/null || echo "$0")"
KIT_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
PRESET_DIR="$KIT_ROOT/preset"

say()  { printf '\033[1;36m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

# Replace the region between two markers in a file with the block in $4.
# Creates the file if absent; appends the block if the markers are absent; replaces
# the interior if they are present. Idempotent — the markers are never duplicated.
# If the on-disk interior differs from the new body it says so (drift: edited since
# install, or updated by the kit), then rewrites it.
write_managed_block() {
  python3 - "$1" "$2" "$3" "$4" "${5:-managed block}" <<'PY'
import os, sys
path, start, end, body_file, label = sys.argv[1:6]
body = open(body_file, encoding="utf-8").read().rstrip("\n")
old = open(path, encoding="utf-8").read() if os.path.exists(path) else ""
new_block = start + "\n" + body + "\n" + end + "\n"
if start in old and end in old:
    pre = old.split(start)[0]
    post = old.split(end, 1)[1]
    current = old.split(start, 1)[1].split(end, 1)[0]
    if current.strip("\n") != body.strip("\n"):
        sys.stderr.write("   note: %s differs from the installed copy "
                         "(edited since install, or updated by the kit)\n" % label)
    out = pre + new_block + post.lstrip("\n")
    if old.endswith("\n") and not out.endswith("\n"):
        out += "\n"
else:
    out = (old.rstrip("\n") + "\n\n" if old.strip() else "") + new_block
open(path, "w", encoding="utf-8").write(out)
PY
}

# One markdown row for the Commands block. Empty command -> "unresolved".
cmd_row() {
  if [ -n "$2" ]; then
    printf '| %s | `%s` |\n' "$1" "$2"
  else
    printf '| %s | unresolved — set by hand, or re-run `speckit-init` after adding a manifest |\n' "$1"
  fi
}

# --- 1. CLI -------------------------------------------------------------------
if ! command -v specify >/dev/null 2>&1; then
  say "specify CLI not found — installing"
  command -v uv >/dev/null 2>&1 || die "need uv (https://docs.astral.sh/uv/) to install ${SPECKIT_PKG}"
  uv tool install "$SPECKIT_PKG"
else
  say "specify CLI v$(specify version 2>/dev/null | grep -oE 'CLI Version +[0-9][0-9.]*' | grep -oE '[0-9][0-9.]*' | head -1 || true)"
fi

# --- 2. Project scaffolding ---------------------------------------------------
if [[ -d "$ROOT/.specify" ]]; then
  say ".specify/ already present — re-running init to refresh"
else
  if [[ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null || true)" ]]; then
    warn "uncommitted changes in $ROOT — commit or stash first so the diff is reviewable"
  fi
  ( cd "$ROOT" && specify init --here --force --non-interactive --ignore-agent-tools \
      --integration opencode --script sh ) >/dev/null
  say "scaffolded .specify/ + .opencode/commands/"
fi

cd "$ROOT"

# --- 2b. Deterministic entry-point command -------------------------------------
# A preset can only `prepend` to commands that already exist — it cannot create one
# (verified: a preset entry naming a new command is silently ignored). So /speckit is
# copied here instead.
#
# Why it exists: the `spec-driven-development` skill loads on roughly 60% of relevant
# requests. Skill matching is semantic, so the skill is a probability surface — fine
# for reasoning, wrong for anything that must always apply. An invoked command is
# deterministic to *invoke*: the user typed it, so it ran. (It is not deterministic to
# *obey* — commands are prompt text like any other, and the model can still deviate.
# A rule that must not be violable needs a hook or a permission, not a command.)
# This gives the workflow a reliable entry point without making the skill carry rules.
ENTRY="$ROOT/.opencode/commands/speckit.md"
ENTRY_SRC="$KIT_ROOT/commands/speckit.md"
if [[ -f "$ENTRY_SRC" ]]; then
  if [[ -f "$ENTRY" ]] && cmp -s "$ENTRY_SRC" "$ENTRY"; then
    say "/speckit entry point already current"
  else
    cp "$ENTRY_SRC" "$ENTRY"
    say "installed /speckit entry point (deterministic workflow entry)"
  fi
else
  die "entry-point source missing at $ENTRY_SRC"
fi

# The fast lane is likewise a command a preset cannot create, so it is copied too.
# Missing source is a warning, not an error: an older kit checkout should still install.
QUICK="$ROOT/.opencode/commands/speckit.quick.md"
QUICK_SRC="$KIT_ROOT/commands/speckit.quick.md"
if [[ -f "$QUICK_SRC" ]]; then
  if [[ -f "$QUICK" ]] && cmp -s "$QUICK_SRC" "$QUICK"; then
    say "/speckit.quick fast lane already current"
  else
    cp "$QUICK_SRC" "$QUICK"
    say "installed /speckit.quick fast lane"
  fi
else
  warn "commands/speckit.quick.md not found in the kit — fast lane not installed"
fi

# --- 2c. Hooks: the one layer that can actually enforce ------------------------
# Everything else in this kit is prompt text — the model can deviate. These two
# hooks run below that layer and cannot be talked out of it:
#   1. block `git commit --no-verify` (the documented bypass)
#   2. block hand-edits to generated files (silently lost on the next init)
# Both are verified to fire. They need the `opencode-yaml-hooks` plugin; without it
# the file is inert, which is why we say so rather than installing it quietly.
HOOK_SRC="$KIT_ROOT/hooks/speckit-hooks.yaml"
HOOK_DST="$ROOT/.opencode/hook/hooks.yaml"
HOOK_PLUGIN="opencode-yaml-hooks"
if [[ -f "$HOOK_SRC" ]]; then
  # Is the plugin registered anywhere the agent will read it?
  PLUGIN_SEEN=false
  for cfg in "$ROOT/opencode.json" "$ROOT/opencode.jsonc" \
             "$HOME/.config/opencode/opencode.json" "$HOME/.config/opencode/opencode.jsonc"; do
    [[ -f "$cfg" ]] && grep -q "$HOOK_PLUGIN" "$cfg" 2>/dev/null && PLUGIN_SEEN=true
  done
  mkdir -p "$ROOT/.opencode/hook"
  if [[ ! -f "$HOOK_DST" ]]; then
    cp "$HOOK_SRC" "$HOOK_DST"
    say "installed project hooks (block --no-verify; protect generated files)"
  elif cmp -s "$HOOK_SRC" "$HOOK_DST"; then
    say "project hooks already current"
  else
    # Never clobber a hooks file we did not write — the project's own hooks live there.
    warn "existing .opencode/hook/hooks.yaml left untouched (it is not ours)."
    warn "  to adopt the kit's two hooks, merge them from $HOOK_SRC"
  fi
  if [[ -f "$HOOK_DST" ]] && ! $PLUGIN_SEEN; then
    warn "hooks installed but INERT: the '$HOOK_PLUGIN' plugin is not in any opencode config."
    warn "  activate with:  opencode plugin $HOOK_PLUGIN   (or add it to the \"plugin\" array)"
    warn "  until then they do nothing — which is safe, but is not enforcement."
  fi
fi

# --- 2d. Permission boundary: the mechanical layer -----------------------------
# A rule that must not be violable needs a permission or a hook, not a command. The
# two hooks cover --no-verify and generated-file edits; this block covers the
# irreversible shell actions no prompt reliably stops (force-push, publish,
# destructive database commands). It lives in the PROJECT config so it is reviewable
# and version-controllable with the project.
#
# opencode evaluates the rules in order and the LAST match wins, so the catch-all is
# first and the specific denies are last. An existing opencode.json is never
# clobbered: the block is printed with a merge instruction instead.
PERM_SRC="$KIT_ROOT/permissions/opencode-permission.jsonc"
OC_JSON="$ROOT/opencode.json"
OC_JSONC="$ROOT/opencode.jsonc"
if [[ -f "$PERM_SRC" ]]; then
  if [[ -f "$OC_JSON" || -f "$OC_JSONC" ]]; then
    EXISTING="$OC_JSON"; [[ -f "$EXISTING" ]] || EXISTING="$OC_JSONC"
    warn "existing $(basename "$EXISTING") left untouched (it is not ours)."
    warn "  to adopt the kit's permission boundary, merge the \"permission\" key from:"
    warn "    $PERM_SRC"
  else
    cp "$PERM_SRC" "$OC_JSON"
    say "installed opencode.json permission boundary (deny force-push / publish / destructive DB)"
  fi
else
  warn "permission block source missing at $PERM_SRC — no boundary installed"
fi

# --- 2e. Autonomy contract -----------------------------------------------------
# One file, not prose repeated in every command: the instruction budget is finite.
# The routing block points at it with a single line (FR-004).
CONTRACT_SRC="$KIT_ROOT/global/autonomy-contract.md"
CONTRACT_DST="$ROOT/.opencode/autonomy-contract.md"
if [[ -f "$CONTRACT_SRC" ]]; then
  mkdir -p "$ROOT/.opencode"
  if [[ -f "$CONTRACT_DST" ]] && cmp -s "$CONTRACT_SRC" "$CONTRACT_DST"; then
    say "autonomy contract already current"
  else
    cp "$CONTRACT_SRC" "$CONTRACT_DST"
    say "installed autonomy contract (.opencode/autonomy-contract.md)"
  fi
else
  warn "autonomy contract source missing at $CONTRACT_SRC"
fi

# --- 3. Preset (template addenda + command contributions) ---------------------
# Uses `preset update` when the preset is already installed — that is the idiomatic
# replace flow (remove + add), and it is what keeps an existing project current.
if [[ -d "$PRESET_DIR" ]]; then
  SRC_VERSION="$(grep -E '^\s+version:' "$PRESET_DIR/preset.yml" 2>/dev/null | head -1 | sed 's/.*"\(.*\)".*/\1/')"
  PLIST="$(specify preset list 2>/dev/null || true)"
  if grep -q "$PRESET_ID" <<<"$PLIST"; then
    INST_VERSION="$(specify preset info "$PRESET_ID" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -E '^\s+Version:' | head -1 | awk '{print $2}')"
    if specify preset update "$PRESET_ID" --dev "$PRESET_DIR" >/dev/null 2>&1; then
      if [[ -n "$INST_VERSION" && "$INST_VERSION" != "$SRC_VERSION" ]]; then
        say "updated preset: $PRESET_ID $INST_VERSION -> $SRC_VERSION"
      else
        say "preset up to date: $PRESET_ID v$SRC_VERSION"
      fi
    else
      die "could not update preset — retry: specify preset update $PRESET_ID --dev \"$PRESET_DIR\""
    fi
  elif specify preset add --dev "$PRESET_DIR" >/dev/null 2>&1; then
    say "installed preset: $PRESET_ID v$SRC_VERSION (template addenda + command rules)"
  else
    die "could not install preset — retry: specify preset add --dev \"$PRESET_DIR\""
  fi
else
  die "preset directory not found at $PRESET_DIR — cannot install the template addenda or command rules"
fi

# --- 4. agent-context extension, pointed at AGENTS.md -------------------------
# NOTE: capture to a var first. Piping a verbose `specify` command straight into
# `grep -q` makes grep exit early on a match, killing the producer with EPIPE —
# and under `set -o pipefail` that non-zero status would be read as "not found".
EXT_LIST="$(specify extension list 2>/dev/null || true)"
if grep -q 'agent-context' <<<"$EXT_LIST"; then
  say "agent-context extension already installed"
elif specify extension add agent-context >/dev/null 2>&1; then
  say "installed agent-context extension"
else
  # Fail loudly. A half-installed project that looks fine is worse than a failed
  # install: the AGENTS.md anchor is what keeps the context file maintained, and
  # silently skipping it produces a project that appears set up but is not.
  die "could not install the agent-context extension — retry: specify extension add agent-context"
fi

CFG=".specify/extensions/agent-context/agent-context-config.yml"
if [[ -f "$CFG" ]]; then
  # Point the extension at AGENTS.md — the anchor BOTH opencode and Freebuff read.
  # Idempotency is handled inside the python block.
  if python3 - "$CFG" <<'PY'
import re, sys
p = sys.argv[1]
s = open(p).read()
if re.search(r'(?m)^[ \t]*-[ \t]*AGENTS\.md[ \t]*$', s):
    sys.exit(0)                      # already anchored
new = re.sub(r'(?m)^context_files:[ \t]*(\[\s*\])?[ \t]*$',
             'context_files:\n  - AGENTS.md', s)
if new == s:
    print("could not locate a context_files key to patch", file=sys.stderr)
    sys.exit(1)
open(p, 'w').write(new)
PY
  then
    say "agent context anchored to AGENTS.md"
  else
    die "could not anchor agent context to AGENTS.md — set context_files in $CFG by hand"
  fi
else
  die "agent-context config not found at $CFG — the extension did not install correctly"
fi

# --- 5. Optional bundled extensions -------------------------------------------
for pair in "bug:$WITH_BUG" "assess:$WITH_ASSESS"; do
  name="${pair%%:*}"; want="${pair##*:}"
  $want || continue
  ELIST="$(specify extension list 2>/dev/null || true)"
  if grep -q "$name" <<<"$ELIST"; then
    say "$name extension already installed"
  elif specify extension add "$name" >/dev/null 2>&1; then
    say "installed $name extension"
  else
    # Explicitly requested, so a failure is an error, not a warning.
    die "could not install the $name extension — retry: specify extension add $name"
  fi
done

# --- 6. AGENTS.md routing block ------------------------------------------------
# Deliberately short. The methodology lives in the `spec-driven-development`
# skill; this block only routes to it and gives command paths for agents that
# cannot invoke /speckit.* commands.
read -r -d '' BRIDGE <<'BRIDGE_EOF' || true
# Spec-Driven Development (Spec Kit)

This project uses Spec Kit. Requirements are written down before code is written, and the
artifacts under `specs/` are the source of truth.

**First act of any session in this project: check the workflow before acting.** If the request
is software work, `spec-driven-development` applies — do not improvise from memory. Prefer
`.opencode/commands/speckit.md` (the `/speckit` entry point): it classifies the request, picks the
smallest workflow that fits, and routes. You are not exempt because the task looks simple.

**Load the `spec-driven-development` skill before specifying, planning, or implementing.**
It carries the workflow, approval gates, traceability and verification rules.

**The skill loads on roughly 60% of relevant requests — `/speckit` is the reliable path.** Invoke
it when you need the workflow to apply for certain.

**End every response with the four-bucket handoff** — Done (with evidence) · Continuing · Decision
needed · Approval required — defined in `.opencode/autonomy-contract.md`. Reversible, in-scope work
is autonomous; only the irreversible, external, or costly needs approval.

## Two rules that are enforced, not advised

`.opencode/hook/hooks.yaml` (requires the `opencode-yaml-hooks` plugin) runs below the prompt layer,
so unlike everything above it cannot be talked out of:

- **`git commit --no-verify` is blocked.** Do not try to skip the project's checks, and do not route
  around this with an equivalent — fix what the check is complaining about, or run the check
  directly to see the failure.
- **Generated files are not hand-edited.** `.opencode/commands/speckit*.md`, `.specify/scripts/`,
  `.specify/templates/` and `.specify/presets/` are regenerated and an edit there is lost. Change
  the kit instead. `.specify/memory/constitution.md` and `specs/` are yours to edit.

## If you cannot invoke `/speckit.*` commands

Agents that do not read `.opencode/commands/` (e.g. Freebuff/Codebuff) can run each step by
reading the command prompt directly and following it as instructions:

| Step | File |
| --- | --- |
| entry point | `.opencode/commands/speckit.md` |
| fast lane (small work) | `.opencode/commands/speckit.quick.md` |
| constitution | `.opencode/commands/speckit.constitution.md` |
| specify | `.opencode/commands/speckit.specify.md` |
| plan | `.opencode/commands/speckit.plan.md` |
| tasks | `.opencode/commands/speckit.tasks.md` |
| implement | `.opencode/commands/speckit.implement.md` |
| converge | `.opencode/commands/speckit.converge.md` |
| clarify | `.opencode/commands/speckit.clarify.md` |
| analyze | `.opencode/commands/speckit.analyze.md` |
| checklist | `.opencode/commands/speckit.checklist.md` |

Substitute the user's feature description wherever the prompt expects `$ARGUMENTS`.
BRIDGE_EOF

AGENTS="$ROOT/AGENTS.md"
if [[ -f "$AGENTS" ]] && ! grep -qF "$BRIDGE_START" "$AGENTS" && [[ -s "$AGENTS" ]]; then
  cp "$AGENTS" "$AGENTS.pre-speckit.bak"
  say "backed up existing AGENTS.md -> AGENTS.md.pre-speckit.bak (diff it, then delete or gitignore)"
fi

BRIDGE_FILE="$(mktemp)"
printf '%s' "$BRIDGE" > "$BRIDGE_FILE"
write_managed_block "$AGENTS" "$BRIDGE_START" "$BRIDGE_END" "$BRIDGE_FILE" "routing block"
rm -f "$BRIDGE_FILE"
say "AGENTS.md routing block installed"

# --- 6b. Commands block + scripts/verify ---------------------------------------
# The single biggest variable cost is discovering how to test. Record the commands
# once, expose one `verify` entry point, and name it in every task's Verification
# line. Detection never guesses: an unmatched stack records `unresolved` (FR-006).
CMD_INSTALL=""; CMD_TEST=""; CMD_LINT=""; CMD_TYPECHECK=""; CMD_BUILD=""
if [[ -f "$ROOT/package.json" ]]; then
  PM="npm"
  [[ -f "$ROOT/pnpm-lock.yaml" ]] && PM="pnpm"
  [[ -f "$ROOT/yarn.lock" ]] && PM="yarn"
  CMD_INSTALL="$PM install"
  [[ "$PM" = "npm" && -f "$ROOT/package-lock.json" ]] && CMD_INSTALL="npm ci"
  grep -qE '"(test)"[[:space:]]*:'      "$ROOT/package.json" && CMD_TEST="$PM test"
  grep -qE '"(lint)"[[:space:]]*:'      "$ROOT/package.json" && CMD_LINT="$PM run lint"
  grep -qE '"(typecheck)"[[:space:]]*:' "$ROOT/package.json" && CMD_TYPECHECK="$PM run typecheck"
  grep -qE '"(build)"[[:space:]]*:'     "$ROOT/package.json" && CMD_BUILD="$PM run build"
fi
if [[ -f "$ROOT/pyproject.toml" || -f "$ROOT/pytest.ini" || -f "$ROOT/tox.ini" ]]; then
  [[ -z "$CMD_TEST" ]] && CMD_TEST="python3 -m pytest"
  if [[ -f "$ROOT/uv.lock" ]]; then
    [[ -z "$CMD_INSTALL" ]] && CMD_INSTALL="uv sync"
  elif [[ -f "$ROOT/pyproject.toml" ]]; then
    [[ -z "$CMD_INSTALL" ]] && CMD_INSTALL="python3 -m pip install -e ."
  fi
  # Only claim a tool when a config file proves it is intended — never guess.
  if [[ -f "$ROOT/ruff.toml" || -f "$ROOT/.ruff.toml" ]] || grep -q '\[tool\.ruff' "$ROOT/pyproject.toml" 2>/dev/null; then
    [[ -z "$CMD_LINT" ]] && CMD_LINT="python3 -m ruff check ."
  fi
  if [[ -f "$ROOT/mypy.ini" || -f "$ROOT/.mypy.ini" ]] || grep -q '\[tool\.mypy' "$ROOT/pyproject.toml" 2>/dev/null; then
    [[ -z "$CMD_TYPECHECK" ]] && CMD_TYPECHECK="python3 -m mypy ."
  fi
fi
if [[ -f "$ROOT/Cargo.toml" ]]; then
  [[ -z "$CMD_INSTALL" ]] && CMD_INSTALL="cargo fetch"
  [[ -z "$CMD_TEST" ]] && CMD_TEST="cargo test"
  [[ -z "$CMD_LINT" ]] && CMD_LINT="cargo clippy"
  [[ -z "$CMD_TYPECHECK" ]] && CMD_TYPECHECK="cargo check"
fi
if [[ -f "$ROOT/go.mod" ]]; then
  [[ -z "$CMD_INSTALL" ]] && CMD_INSTALL="go mod download"
  [[ -z "$CMD_TEST" ]] && CMD_TEST="go test ./..."
  [[ -z "$CMD_LINT" ]] && CMD_LINT="go vet ./..."
  [[ -z "$CMD_TYPECHECK" ]] && CMD_TYPECHECK="go build ./..."
fi
if [[ -f "$ROOT/Makefile" ]] && [[ -z "$CMD_TEST" ]] && grep -qE '^test:' "$ROOT/Makefile"; then
  CMD_TEST="make test"
fi

CMDS_FILE="$(mktemp)"
{
  printf '## Commands\n\n'
  printf 'Detected for this project by `speckit-init`. Run `./scripts/verify` for test → lint → typecheck.\n\n'
  printf '| Purpose | Command |\n| --- | --- |\n'
  cmd_row install "$CMD_INSTALL"
  cmd_row test "$CMD_TEST"
  cmd_row lint "$CMD_LINT"
  cmd_row typecheck "$CMD_TYPECHECK"
  cmd_row build "$CMD_BUILD"
  if [ -n "$CMD_TEST$CMD_LINT$CMD_TYPECHECK$CMD_BUILD" ]; then
    printf '| **verify** | `./scripts/verify` |\n'
  fi
} > "$CMDS_FILE"
write_managed_block "$AGENTS" "$CMDS_START" "$CMDS_END" "$CMDS_FILE" "commands block"
rm -f "$CMDS_FILE"

VERIFY="$ROOT/scripts/verify"
if [ -n "$CMD_TEST$CMD_LINT$CMD_TYPECHECK$CMD_BUILD" ]; then
  if [ -f "$VERIFY" ]; then
    say "scripts/verify already present — left as is"
  else
    mkdir -p "$ROOT/scripts"
    {
      printf '#!/usr/bin/env bash\n'
      printf '# Generated by speckit-init. Runs the project checks in order; stops at the first failure.\n'
      printf 'set -euo pipefail\n'
      printf 'run() { printf "\\n== %%s ==\\n" "$1"; shift; "$@"; }\n'
      [ -n "$CMD_TEST" ]      && printf 'run "test" %s\n' "$CMD_TEST"
      [ -n "$CMD_LINT" ]      && printf 'run "lint" %s\n' "$CMD_LINT"
      [ -n "$CMD_TYPECHECK" ] && printf 'run "typecheck" %s\n' "$CMD_TYPECHECK"
      [ -n "$CMD_BUILD" ]     && printf 'run "build" %s\n' "$CMD_BUILD"
    } > "$VERIFY"
    chmod +x "$VERIFY"
    say "generated scripts/verify"
  fi
else
  warn "no test/lint/build command detected — Commands block records 'unresolved'; no scripts/verify generated"
  warn "  add a manifest (package.json / pyproject.toml / Makefile) or set the command by hand, then re-run"
fi

# --- 8. Let the extension seed its managed block ------------------------------
bash .specify/extensions/agent-context/scripts/bash/update-agent-context.sh >/dev/null 2>&1 || true

# --- Done ---------------------------------------------------------------------
cmds=$(ls -1 .opencode/commands/*.md 2>/dev/null | wc -l | tr -d ' ')
presets=$(ls -1 .specify/presets 2>/dev/null | wc -l | tr -d ' ')
say "done — $cmds commands, $presets preset(s) in $ROOT"
cat <<EOF

Next steps:
  1. Review the changes:  git status && git diff
  2. Open this folder in opencode or Freebuff
  3. Check the composition:  specify preset resolve spec-template
  4. Start the loop (opencode):
       /speckit.constitution
       /speckit.specify
       /speckit.plan
       /speckit.tasks
       /speckit.implement
       /speckit.converge

  In Freebuff, ask it to follow the spec-driven-development skill.
  Optional extensions: --with-bug  --with-assess
EOF
