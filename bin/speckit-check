#!/usr/bin/env bash
# speckit-check — report drift between a project and this kit. Changes nothing.
#
# Answers: "does this repo need the updated kit applied?" and, if so, what exactly
# would change. Read-only by design: `speckit-init` is the thing that writes, and it
# is the thing you run once you have decided.
#
# Usage:
#   speckit-check [path]        one project
#   speckit-check --all <dir>   every project under <dir> that has the kit installed
#
# Exit: 0 = current, 1 = drift found, 2 = not a Spec Kit project,
#       3 = no drift, but a governance decision is needed (a template section the constitution
#           lacks — adopting it is an amendment, not an upgrade)
set -uo pipefail

SELF="$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$0" 2>/dev/null || echo "$0")"
KIT_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
KIT_VERSION="$(grep -E '^\s+version:' "$KIT_ROOT/preset/preset.yml" 2>/dev/null | head -1 | sed 's/.*"\(.*\)".*/\1/')"
PRESET_ID="spec-driven-development"

# --- args ---------------------------------------------------------------------
MODE="one"
TARGET="."
if [ "${1:-}" = "--all" ]; then
  MODE="all"; TARGET="${2:-.}"
elif [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0
else
  TARGET="${1:-.}"
fi

if command -v tput >/dev/null 2>&1 && [ -t 1 ]; then G=$(tput setaf 2); Y=$(tput setaf 3); R=$(tput setaf 1); D=$(tput dim); X=$(tput sgr0); else G=""; Y=""; R=""; D=""; X=""; fi

# --- one project --------------------------------------------------------------
check_one() {
  local root; root="$(cd "$1" 2>/dev/null && pwd)" || return 2
  local drift=0 out=""

  local preset_dir="$root/.specify/presets/$PRESET_ID"
  if [ ! -d "$root/.specify" ]; then
    return 2
  fi
  if [ ! -d "$preset_dir" ]; then
    echo "  not the kit's — has .specify/ but no $PRESET_ID preset"
    return 2
  fi

  local installed; installed="$(grep -E '^\s+version:' "$preset_dir/preset.yml" 2>/dev/null | head -1 | sed 's/.*"\(.*\)".*/\1/')"
  installed="${installed:-unknown}"

  line() { out+="  $1"$'\n'; }

  # 1. preset version + content -------------------------------------------------
  if [ "$installed" = "$KIT_VERSION" ]; then
    line "${G}ok${X}    preset version $installed"
  else
    line "${R}DRIFT${X} preset version ${installed} → ${KIT_VERSION}"; drift=1
  fi
  # Compare content by CAPTURING the diff, not by testing a pipeline's exit code.
  # `diff` exits 1 whenever files differ (normal), and under `set -o pipefail` that
  # 1 propagates through `| grep`, so `if diff | grep; then` took the ELSE branch and
  # reported "identical" exactly when content DIFFERED — the checker was inverted.
  # It survived because the gate's functional test only exercised version drift.
  # Ignore .composed/ (spec-kit generates it) and .DS_Store (macOS metadata).
  local d
  d="$(diff -rq "$KIT_ROOT/preset" "$preset_dir" 2>/dev/null | grep -vE '\.composed|\.DS_Store' || true)"
  if [ -n "$d" ]; then
    local n
    n="$(printf '%s\n' "$d" | grep -c .)"
    line "${Y}DIFF${X}  preset content differs in $n file(s) — re-install applies the rest"
    drift=1
  else
    line "${G}ok${X}    preset content identical"
  fi

  # 2. /speckit entry point -----------------------------------------------------
  local entry="$root/.opencode/commands/speckit.md"
  if [ ! -f "$entry" ]; then
    line "${R}MISS${X}  /speckit entry point (added in 1.5.0)"; drift=1
  elif cmp -s "$KIT_ROOT/commands/speckit.md" "$entry"; then
    line "${G}ok${X}    /speckit entry point current"
  else
    line "${Y}DIFF${X}  /speckit entry point differs from the kit's"; drift=1
  fi

  # 3. hooks --------------------------------------------------------------------
  local hooks="$root/.opencode/hook/hooks.yaml"
  if [ ! -f "$hooks" ]; then
    line "${R}MISS${X}  project hooks (added in 1.8.0) — no enforcement layer in this repo"; drift=1
  elif cmp -s "$KIT_ROOT/hooks/speckit-hooks.yaml" "$hooks"; then
    line "${G}ok${X}    project hooks current"
  elif head -1 "$hooks" 2>/dev/null | grep -q '^# spec-driven-development'; then
    # It carries the kit's header, so it is a KIT file at an older version — not a merge.
    # Byte-difference here means the project is running weaker guards than the kit ships.
    line "${Y}DIFF${X}  project hooks are an older kit version — re-install to get the current guards"; drift=1
  else
    # A project may legitimately MERGE the kit's hooks with its own (e.g. a repo that
    # already had a hooks.yaml). Byte-equality then fails even though nothing is wrong.
    # So require every hook the kit ships to be PRESENT, by id — a merged file passes.
    local missing_hook=0 _hid
    while IFS= read -r _hid; do
      [ -z "$_hid" ] && continue
      grep -qE "^[[:space:]]*-[[:space:]]*id:[[:space:]]*${_hid}([[:space:]]|$)" "$hooks" || missing_hook=1
    done < <(grep -oE '^[[:space:]]*-[[:space:]]*id:[[:space:]]*[A-Za-z0-9_.-]+' "$KIT_ROOT/hooks/speckit-hooks.yaml" | sed 's/.*id:[[:space:]]*//')
    if [ "$missing_hook" -eq 0 ]; then
      line "${G}ok${X}    project hooks carry the kit's hooks (merged with project hooks)"
    else
      line "${Y}DIFF${X}  project hooks present but missing one or more kit hooks (possibly project-edited — check before overwriting)"; drift=1
    fi
  fi

  # 4. AGENTS.md bridge ---------------------------------------------------------
  local agents="$root/AGENTS.md"
  if [ ! -f "$agents" ]; then
    line "${R}MISS${X}  AGENTS.md bridge"; drift=1
  else
    grep -qE "First act of any session in this project|Prefer \`/speckit\`" "$agents" \
      && line "${G}ok${X}    AGENTS.md bridge carries the first-act directive" \
      || { line "${Y}DIFF${X}  AGENTS.md bridge predates the first-act directive"; drift=1; }
    grep -q "enforced, not advised" "$agents" \
      && line "${G}ok${X}    AGENTS.md documents the enforced rules" \
      || { line "${Y}DIFF${X}  AGENTS.md does not mention the hooks (added in 1.8.0)"; drift=1; }
  fi

  # 4b. installed enforcement surface -------------------------------------------
  # The hooks are inert without the permission boundary and the contract, and the gate's
  # checks are inert without scripts/verify. A repo missing any of them used to report
  # "current", which is the one answer a drift checker must never give wrongly.
  local contract="$root/.opencode/autonomy-contract.md"
  if [ -f "$contract" ] && cmp -s "$KIT_ROOT/global/autonomy-contract.md" "$contract"; then
    line "${G}ok${X}    autonomy contract current"
  elif [ -f "$contract" ]; then
    line "${Y}DIFF${X}  autonomy contract differs from the kit's"; drift=1
  else
    line "${R}MISS${X}  autonomy contract (.opencode/autonomy-contract.md) — the four-bucket handoff is undefined"; drift=1
  fi

  local oc="" _f
  for _f in "$root/opencode.json" "$root/opencode.jsonc"; do
    if [ -f "$_f" ]; then oc="$_f"; break; fi
  done
  if [ -z "$oc" ]; then
    line "${R}MISS${X}  permission boundary (no opencode.json) — irreversible shell actions are unguarded"; drift=1
  elif ! grep -q '"permission"' "$oc"; then
    line "${R}MISS${X}  permission key in $(basename "$oc") — irreversible shell actions are unguarded"; drift=1
  elif ! grep -q '"deny"' "$oc"; then
    line "${Y}DIFF${X}  permission block has no deny rules"; drift=1
  elif ! grep -q 'git push\*--force\*' "$oc"; then
    line "${Y}DIFF${X}  permission block lacks the force-push deny"; drift=1
  else
    line "${G}ok${X}    permission boundary present (force-push / publish / destructive DB denied)"
  fi

  local verify="$root/scripts/verify"
  if [ -f "$verify" ]; then
    line "${G}ok${X}    scripts/verify present"
  elif grep -qE '^\| (test|lint|typecheck|build) \| `' "$root/AGENTS.md" 2>/dev/null; then
    line "${R}MISS${X}  scripts/verify — the Commands block records checks but there is no runner for them"; drift=1
  else
    line "${D}skip${X}  no checks recorded in AGENTS.md, so no scripts/verify expected"
  fi

  # 4c. Spec Kit's own view of the integration ----------------------------------
  # `specify integration status` is the native oracle. Its "warning" is EXPECTED when the
  # preset prepends to six commands, so the checker must distinguish that (exactly those
  # six, and the prepend check above proves they still carry it) from a managed file that
  # was rewritten or deleted — which the version string cannot see.
  if command -v specify >/dev/null 2>&1; then
    _int="$(cd "$root" && specify integration status --json 2>/dev/null || true)"
    if [ -n "$_int" ]; then
      _int_rc=0
      python3 -c '
import json, sys
d = json.loads(sys.argv[1])
expected = {".opencode/commands/speckit.%s.md" % c for c in
            ("constitution", "specify", "plan", "tasks", "implement", "converge")}
modified = set((d.get("manifests", {}).get("opencode", {}) or {}).get("modified_files", []))
if d.get("missing_managed_files", 0):
    sys.exit(4)
if modified - expected:
    sys.exit(3)
sys.exit(0)
' "$_int" || _int_rc=$?
      case "$_int_rc" in
        0) line "${G}ok${X}    specify integration status: only the preset's six commands differ (expected)" ;;
        3) line "${Y}DIFF${X}  specify reports a modified managed file outside the preset's six — re-install"; drift=1 ;;
        4) line "${R}MISS${X}  specify reports missing managed command files — re-install"; drift=1 ;;
        *) line "${D}skip${X}  specify integration status did not return parseable JSON" ;;
      esac
    fi
  fi

  # 5. command contributions ----------------------------------------------------
  # The composed commands carry the preset's prepends. If the preset drifted, so did
  # these — but check the ones that exist so a missing file is visible too.
  local missing=0 stripped=0
  for c in constitution specify plan tasks implement converge; do
    _f="$root/.opencode/commands/speckit.$c.md"
    if [ ! -f "$_f" ]; then
      missing=$((missing+1))
    elif ! grep -q '<!-- Source: spec-driven-development -->' "$_f"; then
      # The file exists but the preset's prepend is gone — this is what `specify init --force`
      # does when it rewrites a command. Presence alone cannot see it.
      stripped=$((stripped+1))
    fi
  done
  if [ "$missing" -gt 0 ]; then
    line "${R}MISS${X}  $missing contributed command file(s)"; drift=1
  elif [ "$stripped" -gt 0 ]; then
    line "${Y}DIFF${X}  $stripped contributed command(s) lost the preset prepend — re-install"; drift=1
  else
    line "${G}ok${X}    all 6 contributed commands present and carrying the prepend"
  fi

  # 6. template conformance — a section the template requires and the constitution lacks is a
  #    GOVERNANCE DECISION, not drift. This is the door a real project came through: the preset
  #    appended a Delivery Principles section, speckit-init applied the template change, and the
  #    project's normative document silently disagreed with its own resolved template. "Run
  #    speckit-init" is the WRONG answer to this — adopting the section amends a governance
  #    artifact, which needs approval, a version bump and a decision record. Reported separately
  #    so the two can never be confused.
  #
  #    Written with NO temp files: this script must stay read-only, and a checker that writes is a
  #    checker nobody runs against a repo they care about. (An earlier draft used mktemp + rm -rf
  #    and the kit's own gate caught it — correctly.)
  local decide=0
  local _con="$root/.specify/memory/constitution.md"
  local _res="$root/.specify/scripts/bash/resolve-template.sh"
  if [ -f "$_con" ] && [ -f "$_res" ]; then
    local _heads _miss _h _n
    # Required headings: the template's, minus placeholders and removable option markers.
    _heads="$(bash "$_res" constitution-template 2>/dev/null \
      | grep -E '^#{1,3}[[:space:]]' | sed -e 's/[[:space:]]*$//' -e '/\[/d')"
    if [ -z "$_heads" ]; then
      line "${D}skip${X}  constitution-template did not resolve — cannot check conformance"
    else
      _miss=""
      while IFS= read -r _h; do
        [ -n "$_h" ] || continue
        grep -Fxq -- "$_h" "$_con" || _miss="$_miss$_h"$'\n'
      done <<EOF
$_heads
EOF
      _n="$(printf '%s' "$_miss" | grep -c . || true)"
      if [ "$_n" = "0" ]; then
        line "${G}ok${X}    constitution conforms to the resolved template"
      else
        line "${Y}DECIDE${X}  the resolved template requires $_n section(s) this constitution lacks:"
        while IFS= read -r _h; do
          [ -n "$_h" ] && line "          $_h"
        done <<EOF
$_miss
EOF
        line "          adopting them is an AMENDMENT (approval + version bump + a decision record),"
        line "          NOT an upgrade. speckit-init must never apply them silently."
        decide=1
      fi
    fi
  fi

  printf '%s' "$out"
  if [ "$decide" = "1" ] && [ "$drift" = "0" ]; then return 3; fi
  return $drift
}

# --- run ----------------------------------------------------------------------
if [ "$MODE" = "all" ]; then
  echo "${D}kit $KIT_VERSION · scanning $TARGET${X}"
  echo
  found=0; stale=0; dec=0
  # A project is one with a .specify/ dir; the checker decides if it is ours.
  while IFS= read -r d; do
    root="$(dirname "$d")"
    found=$((found+1))
    printf "%s\n" "${D}$root${X}"
    check_one "$root"; rc=$?
    [ "$rc" = "1" ] && stale=$((stale+1))
    [ "$rc" = "3" ] && dec=$((dec+1))
    [ "$rc" = "2" ] && printf "  ${D}skipped — not a Spec Kit project${X}\n"
    echo
  done < <(find "$TARGET" -maxdepth 6 -type d -name ".specify" 2>/dev/null | sort)
  echo "────────────────────────────────────────────"
  echo "$found project(s) with .specify/ · $stale need the updated kit · $dec need a governance decision"
  if [ "$stale" -gt 0 ]; then exit 1; elif [ "$dec" -gt 0 ]; then exit 3; else exit 0; fi
else
  root="$(cd "$TARGET" 2>/dev/null && pwd)" || { echo "not a directory: $TARGET" >&2; exit 2; }
  echo "${D}$root · kit $KIT_VERSION${X}"
  check_one "$root"; rc=$?
  if [ "$rc" = "2" ]; then
    echo "  not a Spec Kit project (no .specify/)"
  elif [ "$rc" = "1" ]; then
    echo
    echo "  → needs the updated kit:  speckit-init \"$root\""
  elif [ "$rc" = "3" ]; then
    echo
    echo "  → NO upgrade needed. A governance decision is: adopting the sections above amends the"
    echo "    constitution, so it needs approval, a version bump and a decision record —"
    echo "    run: /speckit.constitution"
  else
    echo "  → current, nothing to do"
  fi
  exit $rc
fi
